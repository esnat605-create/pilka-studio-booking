# =============================================================================
#  Переменные окружения страницы записи Pilka Studio
# =============================================================================
#  Этот файл — только образец. Ничего секретного в него вписывать не нужно и в
#  GitHub он попадает намеренно (в отличие от .env, который закрыт .gitignore).
#
#  На боевом сайте эти переменные задаются в панели Netlify:
#     Site configuration → Environment variables → Add a variable
#  После добавления переменных нужно сделать Deploys → Trigger deploy →
#  Deploy site, иначе функции продолжат работать со старыми значениями.
# =============================================================================


# --- ОБЯЗАТЕЛЬНАЯ ------------------------------------------------------------

# Строка подключения к ТОЙ ЖЕ базе Supabase, с которой работает админка Pilka Studio.
#
# Где взять: Supabase → проект "Pilka Studio" → Connect (кнопка вверху) →
# вкладка "Connection string" → выбрать "Transaction pooler" → скопировать
# строку и подставить в неё пароль базы вместо [YOUR-PASSWORD].
#
# ВАЖНО: берите именно пул (Transaction pooler, порт 6543), а не прямое
# подключение на 5432. Каждый вызов серверной функции открывает новое соединение,
# и на прямых подключениях бесплатный Supabase быстро упрётся в лимит — сайт
# начнёт отдавать ошибки в самый неподходящий момент.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:ПАРОЛЬ@aws-1-eu-west-1.pooler.supabase.com:6543/postgres


# --- НЕОБЯЗАТЕЛЬНЫЕ (у всех есть разумные значения по умолчанию) --------------

# Часовой пояс салона, часов от UTC. Сухум — 4, перевода часов нет.
SALON_TZ_OFFSET=4

# На сколько дней вперёд открыта запись.
BOOKING_HORIZON_DAYS=60

# Минимальный запас времени до ближайшей возможной записи, минуты.
# 120 означает, что «на через час» записаться уже нельзя — у салона есть время
# увидеть заявку и перезвонить/написать в WhatsApp.
BOOKING_LEAD_MINUTES=120

# Антиспам: сколько заявок принимается с одного номера телефона за сутки.
MAX_BOOKINGS_PER_PHONE_PER_DAY=3

# Антиспам: сколько будущих активных записей может одновременно висеть на одном
# номере телефона.
MAX_ACTIVE_FUTURE_PER_PHONE=3

# Соль для хеширования IP в журнале заявок. Сам IP нигде не сохраняется —
# только необратимый отпечаток, по которому можно опознать источник спама.
# Впишите сюда любую длинную случайную строку.
IP_HASH_SALT=смените-на-любую-длинную-случайную-строку

# Домен, которому разрешено обращаться к API (CORS). Если оставить пустым,
# страница и функции работают на одном домене — этого достаточно.
# Заполнять нужно, только если форму встраивают на другой сайт.
ALLOWED_ORIGIN=
